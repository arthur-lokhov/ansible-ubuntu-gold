# ---------------------------------------------------------------------------
# EXAMPLE secrets file.  Do not commit the real file.
#
#   cp inventory/group_vars/all/secrets.yml.example \
#      inventory/group_vars/all/secrets.yml
#   $EDITOR inventory/group_vars/all/secrets.yml
#   ansible-vault encrypt inventory/group_vars/all/secrets.yml
#
# Then run every playbook with --ask-vault-pass (or configure a vault
# password file outside the repository).
#
# All values are consumed through the indirection in main.yml, so you can also
# provide them with `-e @secrets.yml` or `--extra-vars` without editing the
# repository.
# ---------------------------------------------------------------------------

vault_luks_passphrase: "CHANGE_ME_luks_passphrase"
vault_user_password: "CHANGE_ME_user_password"
vault_wifi_psk: "CHANGE_ME_wifi_psk"
vault_mok_password: "CHANGE_ME_mok_password"
vault_restic_password: "CHANGE_ME_restic_password"
