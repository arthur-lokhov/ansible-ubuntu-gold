#!/bin/bash
# ---------------------------------------------------------------------------
# gen-fstab - regenerate /etc/fstab from the actual UUIDs of the configured
# devices.  Generated by Ansible from roles/base_config/templates/gen-fstab.j2.
#
# The script is deliberately kept in the installed system as a maintenance
# tool: after adding/removing an LVM volume, edit DEV below and re-run it.
# ---------------------------------------------------------------------------
set -euo pipefail

# --- mapping: logical name -> block device ---------------------------------
declare -A DEV=(
{% for volume in lvm_volumes %}
    [{{ volume.name }}]=/dev/{{ vg_name }}/{{ volume.name }}
{% endfor %}
    [boot]={{ boot_partition }}
    [efi]={{ efi_partition }}
)

command -v blkid >/dev/null || { echo "ERROR: blkid not found" >&2; exit 1; }

# --- collect UUIDs ---------------------------------------------------------
declare -A UUID
for key in "${!DEV[@]}"; do
    dev="${DEV[$key]}"
    [ -b "$dev" ] || { echo "ERROR: $dev is not a block device" >&2; exit 1; }
    uuid=$(blkid -s UUID -o value "$dev" 2>/dev/null || true)
    [ -n "$uuid" ] || { echo "ERROR: $dev has no UUID (not formatted?)" >&2; exit 1; }
    UUID[$key]="$uuid"
done

# --- sanity: no duplicate UUIDs -------------------------------------------
declare -A seen
for key in "${!UUID[@]}"; do
    u="${UUID[$key]}"
    [ -n "${seen[$u]:-}" ] && { echo "ERROR: duplicate UUID $u for $key and ${seen[$u]}" >&2; exit 1; }
    seen[$u]="$key"
done

# --- backup existing fstab ------------------------------------------------
if [ -e /etc/fstab ]; then
    cp -a /etc/fstab "/etc/fstab.bak.$(date +%Y%m%d-%H%M%S)"
fi

# --- atomic write ---------------------------------------------------------
tmp=$(mktemp /etc/.fstab.new.XXXXXX)
trap 'rm -f "$tmp"' EXIT

line() {
    printf '%-42s %-24s %-7s %-49s %-6s %s\n' "$@"
}

{
    line "# <file system>" "<mount point>" "<type>" "<options>" "<dump>" "<pass>"
{% for volume in lvm_volumes %}
    line "UUID=${UUID[{{ volume.name }}]}" "{{ volume.mountpoint }}" "{{ volume.fstype }}" "{{ volume.options }}" "{{ volume.dump }}" "{{ volume.passno }}"
{% endfor %}
    line "UUID=${UUID[boot]}" "/boot" "ext4" "{{ boot_mount_options }}" "0" "2"
    line "UUID=${UUID[efi]}" "/boot/efi" "vfat" "{{ efi_mount_options }}" "0" "1"
    line "tmpfs" "/tmp" "tmpfs" "{{ tmpfs_mount_options }}" "0" "0"
} > "$tmp"

chmod 0644 "$tmp"
mv -f "$tmp" /etc/fstab
trap - EXIT

echo "=== /etc/fstab written ==="
cat /etc/fstab

# --- optional verification (util-linux) -----------------------------------
if command -v findmnt >/dev/null; then
    echo "=== findmnt --verify ==="
    findmnt --verify || echo "WARN: findmnt --verify reported issues (see above)" >&2
fi
